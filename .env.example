# Пароль для входа в админку на сервере.
# Без него админка на боевом сайте закрыта совсем.
ADMIN_PASSWORD=придумайте-свой-пароль

# Уведомления о заявках в телеграм (необязательно, но на Vercel — обязательно:
# там сайт не может сохранять заявки в файл, поэтому телеграм остаётся единственным каналом)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
